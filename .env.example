# PostgreSQL
POSTGRES_DB=standart_reserve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Backend
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/standart_reserve
# Leave empty to auto-generate a key on first production start (persisted in a volume).
SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public hostname used for TLS (self-signed if certs/ is empty).
DOMAIN=localhost
BACKEND_CORS_ORIGINS=["https://localhost","https://127.0.0.1"]

# Frontend
VITE_API_URL=/api/v1

# Published ports for docker-compose.prod.yml
HTTP_PORT=80
HTTPS_PORT=443

# Backups (pg_dump sidecar). 86400 = once a day.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# Host ports for docker-compose.dev.yml (change if 5432/8000/5173 are busy)
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

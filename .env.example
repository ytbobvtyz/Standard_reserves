# PostgreSQL
POSTGRES_DB=standart_reserve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/standart_reserve
SECRET_KEY=change-me-in-production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost","http://127.0.0.1:5173","http://127.0.0.1"]

# Frontend
VITE_API_URL=/api/v1

# Host ports for docker-compose.dev.yml (change if 5432/8000/5173 are busy)
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

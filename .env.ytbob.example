# Скопировать на сервере в каталог с репозиторием:
#   cp .env.ytbob.example .env && chmod 600 .env
# Пароль в POSTGRES_PASSWORD и в DATABASE_URL должен совпадать.

POSTGRES_DB=standart_reserve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random

DATABASE_URL=postgresql://postgres:replace-with-long-random@postgres:5432/standart_reserve
# Пусто — ключ создастся при первом старте и сохранится в volume backend_secrets.
SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DOMAIN=ytbob.ru
BACKEND_CORS_ORIGINS=["https://ytbob.ru"]

# docker network ls | grep muzzzic
MUZZZIC_NETWORK=muzzzic-prod_default

VITE_API_URL=/api/v1

BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
